{
  "name": "avatar-platform",
  "version": "1.1.0",
  "description": "SaaS platform to build embeddable AI talking-character chatbots with Rive + Gemini Live + RAG",
  "main": "backend/server.js",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "node backend/server.js",
    "dev": "node --watch backend/server.js",
    "test": "node --test 'backend/**/*.test.js'",
    "build": "terser public/lipsync-sdk.js -c -m -o public/lipsync-sdk.min.js --source-map",
    "build:sdk": "npm run build --workspaces --if-present",
    "postinstall": "npm run build"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@napi-rs/canvas": "^1.0.2",
    "@supabase/supabase-js": "^2.112.2",
    "bcryptjs": "^2.4.3",
    "cheerio": "^1.0.0-rc.12",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "csv-parse": "^7.0.1",
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.1.0",
    "inngest": "^4.18.0",
    "jsonwebtoken": "^9.0.2",
    "lru-cache": "^11.3.6",
    "mammoth": "^1.7.2",
    "multer": "^1.4.5-lts.1",
    "node-fetch": "^2.7.0",
    "nodemailer": "^9.0.3",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "^6.1.200",
    "pg": "^8.13.3",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "stripe": "^17.7.0",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "terser": "^5.48.0"
  }
}
