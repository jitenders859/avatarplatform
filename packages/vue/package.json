{
  "name": "@avatar-platform/vue",
  "version": "1.1.0",
  "description": "Vue SDK for AvatarPlatform — embed a live AI talking character in any Vue 3 app with one component.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "dependencies": {
    "@avatar-platform/js": "^1.1.0"
  },
  "peerDependencies": {
    "vue": "^3.0.0"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vue": "^3.5.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jitenders859/avatarplatform.git",
    "directory": "packages/vue"
  },
  "keywords": [
    "avatarplatform",
    "vue",
    "chatbot",
    "widget",
    "embed"
  ]
}
