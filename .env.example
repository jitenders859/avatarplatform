# ═══════════════════════════════════════════════════════════════════════
# AvatarPlatform environment — copy to .env and fill in the required values.
# Loading: dotenv in backend/server.js. All keys below are real, read at boot
# or per-request; anything not listed here is not used by the codebase.
# ═══════════════════════════════════════════════════════════════════════

# ── Database (required) ──────────────────────────────────────────────────
# Postgres connection string (Supabase: Settings → Database → Connection
# string; use the Transaction Pooler URL for serverless deploys).
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_PROJECT.supabase.co:6543/postgres?pgbouncer=true
# Set to "false" to disable SSL (local Postgres only). Default: SSL enabled
# with rejectUnauthorized=false (Supabase managed TLS).
# DATABASE_SSL=false
# Pool tuning — see the sizing note in backend/db.js before raising these.
# DB_POOL_MAX=20
# DB_STATEMENT_TIMEOUT_MS=15000

# ── Auth (required) ──────────────────────────────────────────────────────
# Secret for signing JWTs (30d customer / 12h admin / 15m impersonation
# tokens). Boot fails without it. Use a long random string, e.g.:
#   openssl rand -hex 32
JWT_SECRET=

# ── Gemini / AI ──────────────────────────────────────────────────────────
# SERVER-SIDE key (required). Used ONLY on the server: embeddings, text
# extraction, /ask, /study, page-image captioning, quiz distractors.
# ██████████████████████████████████████████████████████████████████████
# █ WARNING: this key must NEVER be exposed to visitors. It is never      █
# █ sent to the browser — /embed/:id/config only ever returns             █
# █ PUBLIC_GEMINI_API_KEY. If PUBLIC_GEMINI_API_KEY is unset (or set to   █
# █ the same value as this key — treated as unset), live voice is         █
# █ disabled and widgets run text-only via the server-side /ask path.     █
# █ Do NOT set PUBLIC_GEMINI_API_KEY=GEMINI_API_KEY.                      █
# ██████████████████████████████████████████████████████████████████████
GEMINI_API_KEY=

# BROWSER-SIDE key (recommended). Delivered to every visitor's browser via
# GET /embed/:publicId/config for the Gemini Live voice WebSocket — treat it
# as PUBLIC. Create a SEPARATE key in Google AI Studio and restrict it:
#   - API restrictions: only the Gemini Live API (generativelanguage.googleapis.com)
#   - Application restrictions: HTTP referrers / quota caps per this key
# so a scraped key can't be used for embeddings or other paid API surface,
# and per-visitor abuse is capped at this key's quota instead of your bill.
PUBLIC_GEMINI_API_KEY=

# Model overrides (defaults shown are what the code uses when unset).
# EMBEDDING_MODEL=gemini-embedding-2-preview
# EMBEDDING_DIMENSIONS=768            # must match vector(N) in supabase/schema.sql
# STUDY_MODEL=gemini-2.5-flash
# QUIZ_MODEL=gemini-3.5-flash
# FLASHCARD_MODEL=gemini-3.5-flash
# QUIZ_DISTRACTOR_MODEL=gemini-3.1-flash-lite
# PAGE_CLASSIFY_MODEL=gemini-3.5-flash
# Figure retrieval tuning (see backend/services/figures.js, pageImages.js)
# FIGURE_MATCH_THRESHOLD=0.5
# MAX_FIGURES_PER_ANSWER=4
# MAX_PAGE_IMAGE_PAGES=200
# MAX_FIGURES_PER_PAGE=6

# ── Web search grounding ──────────────────────────────────────────────────
# Serper.dev API key (https://serper.dev) — powers the search_web tool the
# avatar can call when its knowledge base doesn't have an answer. Only
# takes effect for projects with webSearchEnabled=true (see project
# settings). Settable here or via the admin settings panel (services/settings.js).
SERPER_API_KEY=

# ── Supabase Storage (required for file uploads + serving) ───────────────
# uploads go browser→Supabase direct via signed URLs (see backend/routes/
# files.js); page-image figures are also stored here.
SUPABASE_URL=
# Service-role key — SERVER ONLY. Never expose to the browser.
SUPABASE_SECRET_KEY=
# Publishable/anon key — safe to expose; used client-side for the direct
# storage upload (served via GET /api/config).
SUPABASE_PUBLISHABLE_KEY=

# ── Stripe billing (optional — billing endpoints return 503 without it) ──
STRIPE_SECRET_KEY=
# Webhook signing secret (starts with whsec_) from the Stripe dashboard.
# Register these events on https://<your-domain>/api/billing/webhook:
#   checkout.session.completed, customer.subscription.created,
#   customer.subscription.updated, customer.subscription.deleted
STRIPE_WEBHOOK_SECRET=
# Price IDs (start with price_) from your Stripe products:
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# ── Email (optional — password reset + welcome emails no-op without it) ──
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@yourdomain.com
# Public URL used in password-reset links.
# APP_URL=http://localhost:8080

# ── SMS (optional — usage-limit text alerts no-op without it) ────────────
# Twilio account — see backend/services/sms.js. Only used for the opt-in
# "you're approaching/hit your plan limit" text (backend/services/usage.js's
# runUsageAlertSweep); the matching email always sends regardless.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# ── Rate limiting (strongly recommended for production / Vercel) ─────────
# Shared store for express-rate-limit (see backend/services/rateLimitStore.js
# and project.md → Deployment → Rate limiting). Without one of these, all
# limiters fall back to in-memory MemoryStore and are effectively DISABLED
# on Vercel (fresh store per invocation) and per-instance when scaled out.
# Option 1 — Upstash over REST (recommended on serverless; HTTP-only):
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# (UPSTASH_REDIS_URL / UPSTASH_REDIS_TOKEN accepted as aliases.)
# Option 2 — any Redis over TCP (redis:// or rediss:// for TLS):
# REDIS_URL=

# ── Server ───────────────────────────────────────────────────────────────
# PORT=8080
# NODE_ENV=development                # "production" disables pino-pretty
# LOG_LEVEL=info

# ── Phase 2/3 integrations (all optional — see
# docs/competitor-feature-implementation-plan.md) ─────────────────────────
# Voice cloning (2c) — backend/services/elevenlabsVoice.js.
# ELEVENLABS_API_KEY=

# Inworld TTS-2 / TTS-2 Flash — backend/services/inworldTts.js. Standalone
# library, NOT wired into the voice-engine selector yet; only reachable via
# the admin-only POST /api/admin/inworld-tts-test route for manual testing.
# INWORLD_API_KEY=
# INWORLD_VOICE_ID=

# WhatsApp channel (3b) — backend/routes/whatsapp.js. WHATSAPP_VERIFY_TOKEN
# is any string you choose, entered again in Meta's dashboard for the
# one-time webhook handshake. WHATSAPP_APP_SECRET is your Meta app's secret,
# used to verify each webhook POST is genuinely from Meta.
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=

# SSO / OIDC login (3c) — SECURITY NOTE: read the header comment in
# backend/services/oidc.js before setting these in a real deployment; this
# has not had a security review or been tested against a live IdP. All four
# must be set for the "Continue with SSO" login button to appear.
# OIDC_ISSUER=https://your-idp.example.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=http://localhost:8080/api/auth/sso/callback

# ── Google Calendar (tour booking) — optional ─────────────────────────────
# Powers the check_availability/book_tour AI tools (advanced capability
# tier) — see backend/services/googleCalendar.js. Create OAuth 2.0
# credentials in Google Cloud Console (APIs & Services → Credentials →
# Create Credentials → OAuth client ID, type "Web application"), enable the
# Google Calendar API for the project, and add the exact
# GOOGLE_CALENDAR_REDIRECT_URI value below as an authorized redirect URI.
# This URI is fixed (not per-project — see googleCalendarAuth.js). Inert
# (503 on connect) unless all three are set.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8080/api/google-calendar/callback