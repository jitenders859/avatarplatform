# --- Database ---
# Postgres connection string (no pgvector needed for this project — it's not RAG-based).
DATABASE_URL="postgresql://user:password@localhost:5432/aviation_ground_school"

# --- Auth ---
# Random 32+ byte secret used to sign session JWTs.
JWT_SECRET="change-me-to-a-long-random-string"

# --- Anthropic Claude (ground-school chatbot brain) ---
ANTHROPIC_API_KEY="sk-ant-..."
ANTHROPIC_MODEL="claude-sonnet-5"

# --- Stripe (student subscriptions / paywall) ---
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# Price IDs for the paid plan(s) students subscribe to once their free trial runs out.
STRIPE_PRICE_MONTHLY="price_..."
STRIPE_PRICE_ANNUAL="price_..."

# --- Stripe Connect (instructor payouts + platform commission) ---
# Same Stripe account as above; Connect uses STRIPE_SECRET_KEY. This is the webhook
# secret for the *Connect* webhook endpoint (separate endpoint/secret from the one above).
STRIPE_CONNECT_WEBHOOK_SECRET="whsec_..."
# Platform commission taken out of every paid (non-trial) instructor session, in basis points.
# 1500 = 15%.
PLATFORM_COMMISSION_BPS=1500

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Free-trial config for the chatbot (messages a student gets before the paywall kicks in).
FREE_CHAT_MESSAGE_LIMIT=20

# Length of a student's free first session with any given instructor, in minutes.
FREE_INSTRUCTOR_SESSION_MINUTES=30
